docker-compose.override.yml

# Node (frontend)
node_modules/
.next/
out/
.nuxt/

# Build
*.pyc
*.pyo

# AI logs — tracked structure, ignored content
.ai-log/*.jsonl
.ai-log/archive/

# Crawler resume state — internal checkpoint, not a deliverable
crawler/**/*.progress.txt
data pharmacy/**/*.progress.txt

# Generated RAG chunk staging file (scripts/chunk_drugs.py) — derivable from
# thuoc.json + script, large (~37MB), not a deliverable.
data pharmacy/_chunks.jsonl

# Vercel CLI link + pulled env (per-developer, never committed)
.vercel
.env*
# ...but the template must stay in the repo
!.env.example

# Prototype runtime output — not a deliverable
prototypes/**/missing_drugs_log.jsonl
