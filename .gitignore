# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/

# Environment variables
.env
.env.local
.env.production

# API keys / secrets accidentally dropped at repo root (incident 2026-08-08:
# api.txt held a live key, was untracked but never verified safe until this
# pattern was added - see report.md for the rotation note)
api.txt
*api_key*.txt
secrets.txt

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code personal settings
.claude/settings.local.json
.claude/skills/
.mcp.json

# OS
.DS_Store
Thumbs.db

# Data (never commit large data)
data/
*.db
*.sqlite3

# B-04 keeps only the small, reproducible query metadata under data/.  Reference
# and synthetic binaries remain ignored and are generated/read locally.
!data/
!data/drug-images/
!data/drug-images/eval/
!data/drug-images/eval/visual_retrieval_v1.jsonl
!data/drug-images/eval/drug_recognition_v1.jsonl

# Logs
logs/
*.log

# Test coverage
htmlcov/
.coverage
coverage.xml
.test-tmp/

# Docker
docker-compose.override.yml

# Node (frontend)
node_modules/
.next/
out/
.nuxt/

# Build
*.pyc
*.pyo

# AI logs — tracked structure, ignored content
.ai-log/*.jsonl
.ai-log/archive/
.ai-log/submit-not-before.json

# Crawler resume state — internal checkpoint, not a deliverable
crawler/**/*.progress.txt
data pharmacy/**/*.progress.txt

# Generated RAG chunk staging file (scripts/chunk_drugs.py) — derivable from
# thuoc.json + script, large (~37MB), not a deliverable.
data pharmacy/_chunks.jsonl

# Railway CLI link (per-developer, per-directory: root -> BE, frontend/ -> FE)
.railway/
# Local env — pulled from Railway with `railway variables`, never committed
.env*
# ...but the template must stay in the repo
!.env.example

# Prototype runtime output — not a deliverable
prototypes/**/missing_drugs_log.jsonl

# BUILD-35 golden evaluation run artifacts — generated per-run by
# scripts/agent_v2/run_golden_evaluation.py, not a deliverable. The dataset
# itself (scripts/agent_v2/golden/golden_set_*.json) is NOT covered by this
# pattern and stays committed.
scripts/agent_v2/golden/runs/
