# Backend (FastAPI) deployment — only src/ + requirements.txt are needed.
# Everything below is excluded from the upload to keep the bundle small and
# to avoid shipping datasets/docs to a serverless function.

# The Next.js app deploys as its own Vercel project (root: frontend/)
frontend/

# Datasets & crawler artifacts (~16MB, not read at runtime)
data pharmacy/
crawler/
data/

# Docs, planning, presentation material
docs/
adrs/
planning/
presentation/
specs/
tasks/
eval/
*.md

# Standalone VLM tooling — not imported by src/main.py, ships its own requirements
src/vlm_demthuoc/

# Tests & local tooling
tests/
scripts/
Dockerfile
docker-compose.yml
Makefile
ruff.toml

# Local caches
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
