# Copy to .env.local and adjust if the backend runs elsewhere.
# Next.js only exposes vars prefixed with NEXT_PUBLIC_ to client code.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only (KHONG co prefix NEXT_PUBLIC_, khong lot vao bundle trinh duyet).
# Phai khop dung gia tri INTERNAL_AUTH_SECRET dang set o backend - dung boi
# app/api/chat/route.ts de goi POST /api/v1/chat that (backend/api/security.py::
# require_internal_secret). Thieu bien nay thi trang chat local se bao loi 500
# "Server misconfigured", khong phai loi backend.
INTERNAL_AUTH_SECRET=
