# Copy to .env.local and adjust if the backend runs elsewhere.
# Next.js only exposes vars prefixed with NEXT_PUBLIC_ to client code.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only (KHONG co prefix NEXT_PUBLIC_, khong lot vao bundle trinh duyet).
# Phai khop dung gia tri INTERNAL_AUTH_SECRET dang set o backend - dung boi
# app/api/chat/route.ts de goi POST /api/v1/chat that (backend/api/security.py::
# require_internal_secret). Thieu bien nay thi trang chat local se bao loi 500
# "Server misconfigured", khong phai loi backend.
INTERNAL_AUTH_SECRET=

# ---- Login with Google (Better Auth) ----
# Better Auth chi lam moi gioi OAuth; JWT that van do backend phat (xem
# frontend/src/lib/better-auth.ts). Thieu BAT KY bien nao trong 4 bien duoi thi
# nut "Đăng nhập bằng Google" bao 503 thay vi that bai giua luong OAuth.
#
# Sinh secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Origin cua CHINH frontend (khong phai backend). Thieu bien nay tren
# production thi callback URL roi ve localhost -> Google bao redirect_uri_mismatch.
#   - Local : http://localhost:3000
#   - Prod  : https://vmec-04fe-production.up.railway.app
BETTER_AUTH_URL=http://localhost:3000
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (Application type: Web application). Authorized redirect URIs PHAI co dung
# ca 2 dong sau (basePath /api/better-auth, khong phai /api/auth mac dinh):
#   http://localhost:3000/api/better-auth/callback/google
#   https://vmec-04fe-production.up.railway.app/api/better-auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Better Auth luu 4 bang ba_user/ba_session/ba_account/ba_verification trong
# CHINH Postgres cua du an (migration 0025). Dung URL giong DATABASE_URL cua
# backend; qua public proxy cua Railway thi phai kem ?sslmode=require.
DATABASE_URL=
