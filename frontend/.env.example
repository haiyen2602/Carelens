# Copy to .env.local and adjust if the backend runs elsewhere.
# Next.js only exposes vars prefixed with NEXT_PUBLIC_ to client code.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only (KHONG co prefix NEXT_PUBLIC_, khong lot vao bundle trinh duyet).
# Phai khop dung gia tri INTERNAL_AUTH_SECRET dang set o backend - dung boi
# app/api/chat/route.ts va app/api/auth/google-bridge/route.ts
INTERNAL_AUTH_SECRET=

# ---- Supabase Auth (ADR-0013) ----
# Cau hinh de su dung Supabase Auth cho Google Sign-In va OAuth flow.
# Lay thong tin tu Supabase Project Settings > API:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
