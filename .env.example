# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database (PostgreSQL + pgvector, xem docker-compose.yml + ADR-0008) ----
POSTGRES_USER=vmec
POSTGRES_PASSWORD=vmec
POSTGRES_DB=vmec04
DATABASE_URL=postgresql://vmec:vmec@localhost:5432/vmec04

# ---- Embedding (RAG data thuoc, xem specs/chatbot-rag-design.md) ----
EMBEDDING_MODEL=text-embedding-3-small

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- TEMP auth gate cho /api/v1/chat (chatbot-rag-design.md muc 10 #10) ----
# KHONG PHAI auth that - chi chan truy cap ngoai pham vi thu nghiem noi bo
# trong luc auth-api (JWT) chua co timeline. BAT BUOC dat gia tri THAT (khac
# gia tri mac dinh trong src/config.py) cho bat ky moi truong nao chia se
# ngoai may ca nhan - xoa bien nay + src/api/security.py khi auth-api that co.
INTERNAL_AUTH_SECRET=change-me-to-a-real-secret-for-any-shared-environment

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=f3p1dEOhD_z8qjjtbeCtb2t9ASMEliz-4juZfWe3ZPgCtPZp-LjWthBfeNU8d5dP
AI_LOG_DIR=.ai-log

