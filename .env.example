# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- VLM dem thuoc (backend/vlm_demthuoc/, chay doc lap bang run.bat) ----
# Endpoint RIENG, khong dung chung key voi OPENAI_API_KEY o tren. De trong ca
# 5 bien thi chuong trinh tu quay ve doc backend/vlm_demthuoc/api_key.json.
VLM_API_KEY=
VLM_PROVIDER=openai
# Ten viet tat (openrouter, groq, gemini, ollama...) hoac URL day du dang https://.../v1
VLM_BASE_URL=
# Model PHAI ho tro anh (vision).
VLM_MODEL=
# schema | object | off. Dat 'off' cho endpoint tra ve SSE rong khi co
# response_format (vd api.vilao.ai) — luc do JSON duoc ep bang system prompt.
VLM_JSON_MODE=schema
# Cho toi da bao nhieu giay cho MOT lan goi API. Mot lan dem that mat ~25s.
# Qua gio thi bao loi luon, khong thu lai (khac VLM_RETRIES ben duoi).
VLM_TIMEOUT=45
# So lan goi lai khi may chu tra phan hoi RONG NGAY LAP TUC (loi cua vilao).
VLM_RETRIES=5

# ---- Database (PostgreSQL + pgvector, xem docker-compose.yml + ADR-0008) ----
POSTGRES_USER=vmec
POSTGRES_PASSWORD=vmec
POSTGRES_DB=vmec04
DATABASE_URL=postgresql://vmec:vmec@localhost:5432/vmec04

# ---- Embedding (RAG data thuoc, xem specs/chatbot-rag-design.md) ----
EMBEDDING_MODEL=text-embedding-3-small

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- TEMP auth gate cho /api/v1/chat (chatbot-rag-design.md muc 10 #10) ----
# BAT BUOC - khong co gia tri that o day thi app/test suite KHONG khoi dong
# duoc (fail-closed that, xem backend/config.py::_internal_auth_secret_must_be_
# configured - raise ngay luc doc config, ke ca local dev/test, khong chi
# canh bao). KHONG PHAI auth that - chi chan truy cap ngoai pham vi thu
# nghiem noi bo trong luc auth-api (JWT) chua co timeline. Xoa bien nay +
# backend/api/security.py khi auth-api that co.
INTERNAL_AUTH_SECRET=change-me-to-a-real-secret-for-any-shared-environment

# ---- auth-api that (TASK-010, api-contracts.md muc 1) ----
# BAT BUOC - cung fail-closed nhu INTERNAL_AUTH_SECRET o tren (xem
# backend/config.py::_jwt_secret_must_be_configured). Dung de ky/giai ma JWT
# (Authorization: Bearer <JWT>, payload sub+role).
JWT_SECRET=change-me-to-a-real-secret-for-any-shared-environment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Supabase Auth (ADR-0013) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Langfuse Observability & Evaluation (docs/langfuse_rag_admin_monitoring_spec.md) ----
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log

# ---- Frontend (frontend/.env.local, Next.js — see frontend/.env.example) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Web Push (VAPID) - de RONG thi tinh nang push tat han, app van chay binh
# thuong (nhac o client van hoat dong). Sinh cap khoa rieng cho moi truong
# cua ban, KHONG dung chung khoa voi nguoi khac:
#   .venv/Scripts/python -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); ..."
# Xem huong dan day du trong docs/DEPLOY.md.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:capymedi@example.com
