# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
# Agent V2 may use separate OpenAI projects per workload. Leave these empty
# locally to use OPENAI_API_KEY; production may configure each independently.
OPENAI_ROUTER_API_KEY=
OPENAI_MAIN_API_KEY=
OPENAI_FALLBACK_API_KEY=
OPENAI_EMBEDDING_API_KEY=
OPENAI_JUDGE_API_KEY=
AGENT_ROUTER_MODEL=gpt-5.4-nano
AGENT_MAIN_MODEL=gpt-5.4-mini
AGENT_FALLBACK_MODEL=gpt-5.4
AGENT_EMBEDDING_MODEL=text-embedding-3-small
RAG_JUDGE_MODEL=gpt-4o
# Exact model pricing is deployment-owned and intentionally defaults unknown.
# Populate only from an approved current provider price catalog; never place keys here.
# BUILD-21: populated below from OpenAI's own published per-1M-token pricing
# (developers.openai.com/api/docs/pricing, checked 2026-08-19) for the exact
# 5 models AGENT_ROUTER/MAIN/FALLBACK/EMBEDDING_MODEL + RAG_JUDGE_MODEL
# default to above. Re-verify against the current published table before
# reusing this value in a new deployment -- provider pricing changes.
AGENT_MODEL_PRICING_JSON={"gpt-5.4-nano":{"input_per_million":0.20,"cached_input_per_million":0.02,"output_per_million":1.25},"gpt-5.4-mini":{"input_per_million":0.75,"cached_input_per_million":0.075,"output_per_million":4.50},"gpt-5.4":{"input_per_million":2.50,"cached_input_per_million":0.25,"output_per_million":15.00},"gpt-4o":{"input_per_million":2.50,"cached_input_per_million":1.25,"output_per_million":10.00},"text-embedding-3-small":{"input_per_million":0.02,"cached_input_per_million":0.0,"output_per_million":0.0}}
# Agent V2 remains disabled by default. Limits are enforced server-side.
AGENT_RUNTIME_ENABLED=false
# BUILD-20: 6, not 4 -- every tool-calling run costs 1 planning step + 1 step
# per tool call + 1 synthesis step (Planning -> Tools -> Synthesis,
# BUILD-19B); 4 left no room for synthesis once 3+ tools were called. See
# backend/config.py::agent_max_steps for the full rationale.
AGENT_TOKEN_BUDGET=4096
AGENT_MAX_STEPS=6
AGENT_MAX_MODEL_CALLS=2
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_RETRIES=1
AGENT_MODEL_TIMEOUT_SECONDS=15
AGENT_RUN_TIMEOUT_SECONDS=30
AGENT_SAFETY_TIMEOUT_SECONDS=5
AGENT_CONTEXT_TOKEN_BUDGET=3072
AGENT_OUTPUT_TOKEN_RESERVE=1024
AGENT_CONTEXT_SHORT_TERM_FRACTION=0.10
AGENT_CONTEXT_LONG_TERM_FACTS_FRACTION=0.04
AGENT_CONTEXT_EPISODIC_FRACTION=0.03
AGENT_CONTEXT_SEMANTIC_FRACTION=0.03
AGENT_RETRIEVAL_TOP_K=5
AGENT_RETRIEVAL_TOKEN_BUDGET=700
# Public supplementary web evidence. The Agent V2 runtime stays disabled.
AGENT_VINMEC_WEB_ENABLED=false
AGENT_VINMEC_WEB_MAX_CALLS=1
AGENT_VINMEC_WEB_MAX_RESULTS=3
AGENT_VINMEC_WEB_TIMEOUT_SECONDS=5
AGENT_VINMEC_WEB_TOKEN_BUDGET=600
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- VLM dem thuoc (backend/vlm_demthuoc/, chay doc lap bang run.bat) ----
# Endpoint RIENG, khong dung chung key voi OPENAI_API_KEY o tren. De trong ca
# 5 bien thi chuong trinh tu quay ve doc backend/vlm_demthuoc/api_key.json.
VLM_API_KEY=
VLM_PROVIDER=openai
# Ten viet tat (openrouter, groq, gemini, ollama...) hoac URL day du dang https://.../v1
VLM_BASE_URL=
# Model PHAI ho tro anh (vision).
VLM_MODEL=
# schema | object | off. Dat 'off' cho endpoint tra ve SSE rong khi co
# response_format (vd api.vilao.ai) — luc do JSON duoc ep bang system prompt.
VLM_JSON_MODE=schema
# Cho toi da bao nhieu giay cho MOT lan goi API. Mot lan dem that mat ~25s.
# Qua gio thi bao loi luon, khong thu lai (khac VLM_RETRIES ben duoi).
VLM_TIMEOUT=45
# So lan goi lai khi may chu tra phan hoi RONG NGAY LAP TUC (loi cua vilao).
VLM_RETRIES=5

# ---- Database (PostgreSQL + pgvector, xem docker-compose.yml + ADR-0008) ----
POSTGRES_USER=vmec
POSTGRES_PASSWORD=vmec
POSTGRES_DB=vmec04
DATABASE_URL=postgresql://vmec:vmec@localhost:5432/vmec04

# ---- Embedding (RAG data thuoc, xem specs/chatbot-rag-design.md) ----
EMBEDDING_MODEL=text-embedding-3-small

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Catalog reference images are stored in a local/attached volume, separate
# from PHI-bearing dose-verification uploads.
DRUG_IMAGE_STORAGE_DIR=./data/drug_images

# ---- TEMP auth gate cho /api/v1/chat (chatbot-rag-design.md muc 10 #10) ----
# BAT BUOC - khong co gia tri that o day thi app/test suite KHONG khoi dong
# duoc (fail-closed that, xem backend/config.py::_internal_auth_secret_must_be_
# configured - raise ngay luc doc config, ke ca local dev/test, khong chi
# canh bao). KHONG PHAI auth that - chi chan truy cap ngoai pham vi thu
# nghiem noi bo trong luc auth-api (JWT) chua co timeline. Xoa bien nay +
# backend/api/security.py khi auth-api that co.
INTERNAL_AUTH_SECRET=change-me-to-a-real-secret-for-any-shared-environment

# ---- auth-api that (TASK-010, api-contracts.md muc 1) ----
# BAT BUOC - cung fail-closed nhu INTERNAL_AUTH_SECRET o tren (xem
# backend/config.py::_jwt_secret_must_be_configured). Dung de ky/giai ma JWT
# (Authorization: Bearer <JWT>, payload sub+role).
JWT_SECRET=change-me-to-a-real-secret-for-any-shared-environment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Supabase Auth (ADR-0013) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Langfuse Observability & Evaluation (docs/langfuse_rag_admin_monitoring_spec.md) ----
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=true

# ---- Langfuse RIENG cho pipeline VLM (dem thuoc + doi chieu don, xem
# backend/services/vlm_telemetry.py) - project/key KHAC voi LANGFUSE_* o tren
# (do la cua RAG chatbot) ----
VLM_LANGFUSE_PUBLIC_KEY=pk-lf-your-vlm-public-key
VLM_LANGFUSE_SECRET_KEY=sk-lf-your-vlm-secret-key
VLM_LANGFUSE_HOST=https://cloud.langfuse.com
VLM_LANGFUSE_ENABLED=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log

# ---- Frontend (frontend/.env.local, Next.js — see frontend/.env.example) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Web Push (VAPID) - de RONG thi tinh nang push tat han, app van chay binh
# thuong (nhac o client van hoat dong). Sinh cap khoa rieng cho moi truong
# cua ban, KHONG dung chung khoa voi nguoi khac:
#   .venv/Scripts/python -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); ..."
# Xem huong dan day du trong docs/DEPLOY.md.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:capymedi@example.com

# Telegram bot - kenh nhac gio uong thuoc THU HAI ben canh Web Push. De RONG
# thi kenh nay tat han, app van chay binh thuong (giong VAPID o tren).
#
# Cach lay token (mien phi, 2 phut, KHONG can dang ky doanh nghiep):
#   1. Mo Telegram, nhan @BotFather
#   2. Gui /newbot -> dat ten hien thi -> dat username (phai ket thuc bang "bot")
#   3. BotFather tra ve token dang 123456789:AAF...  -> dan vao TELEGRAM_BOT_TOKEN
#   4. Dien username vua dat (KHONG co dau @) vao TELEGRAM_BOT_USERNAME
#
# LUU Y: ban hien tai dung long-polling (getUpdates) nen chay duoc ngay tren
# may local, khong can domain public. Neu sau nay chuyen sang webhook thi PHAI
# bo job telegram_updates trong escalation_scheduler.py - Telegram tu choi
# getUpdates bang 409 khi da dat webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Gio hien trong tin nhan (VN = 7). Web Push khong can vi trinh duyet tu doi
# theo gio may, con Telegram gui text tho nen phai doi o server.
TELEGRAM_DISPLAY_UTC_OFFSET_HOURS=7
